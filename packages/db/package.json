{
  "name": "@tiptalk/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma": "./prisma/schema.prisma"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "prisma studio",
    "lint": "echo skip",
    "typecheck": "tsc --noEmit",
    "test": "echo no-tests-in-db-package",
    "admin:promote": "dotenv -e ../../.env -- tsx prisma/promote-admin.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "@tiptalk/config": "workspace:*",
    "argon2": "0.41.1"
  },
  "devDependencies": {
    "dotenv-cli": "7.4.2",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}

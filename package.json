{
  "name": "tiptalk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tiptalk/web test:e2e",
    "db:migrate": "pnpm --filter @tiptalk/db migrate",
    "db:seed": "pnpm --filter @tiptalk/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "@types/node": "22.7.5"
  }
}

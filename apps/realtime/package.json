{
  "name": "@tiptalk/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@tiptalk/config": "workspace:*",
    "@tiptalk/db": "workspace:*",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.7.5",
    "socket.io-client": "4.8.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}

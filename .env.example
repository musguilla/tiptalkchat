# ============================================================================
# TipTalk — example environment. Copy to .env for local dev.
# For production (Vercel / Railway), set these on each service's dashboard.
# ============================================================================

# --- App URLs (point to whatever you have running) ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
REALTIME_URL=http://localhost:4001
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Postgres) ---
# Local dev with docker compose:
#   docker compose up -d postgres
#   DATABASE_URL=postgresql://tiptalk:tiptalk@localhost:5432/tiptalk
# Supabase pooled (production app servers):
#   DATABASE_URL=postgresql://postgres:PWD@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase direct (Prisma migrations only):
#   DIRECT_DATABASE_URL=postgresql://postgres:PWD@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://tiptalk:tiptalk@localhost:5432/tiptalk

# --- Redis ---
# Local: redis://localhost:6379
# Upstash: rediss://default:TOKEN@...upstash.io:6379
REDIS_URL=redis://localhost:6379

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace-with-32-char-random-string-please
JWT_REFRESH_SECRET=replace-with-another-32-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Storage (image uploads) ---
# Options: supabase | r2 | s3 (MinIO-compatible). Default: supabase if SUPABASE_*
# set, else s3.
STORAGE_PROVIDER=supabase

# Supabase Storage (recommended if you're already on Supabase)
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key
SUPABASE_BUCKET=tiptalk-media

# S3 / R2 / MinIO — used when STORAGE_PROVIDER != supabase
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tiptalk-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/tiptalk-media

# --- Video pipeline ---
# 'mux' = Mux Direct Upload + webhooks + CDN HLS (production).
# 'local' = upload to S3/Supabase, apps/worker uses ffmpeg to make HLS (dev).
VIDEO_PROVIDER=local
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# --- WebRTC SFU ---
# 'p2p' = browser-to-browser via signaling + coturn (small groups).
# 'livekit' = LiveKit Cloud token issued by api (groups + included TURN).
SFU_PROVIDER=p2p
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Call recording (moderation) — LiveKit Egress to S3-compatible storage.
# Optional: the admin live-viewer works without these. To enable recording,
# create S3 access keys in Supabase (Storage → S3 connection) and point here.
# LIVEKIT_RECORD_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# LIVEKIT_RECORD_S3_REGION=eu-central-1
# LIVEKIT_RECORD_S3_BUCKET=recordings
# LIVEKIT_RECORD_S3_ACCESS_KEY=
# LIVEKIT_RECORD_S3_SECRET_KEY=

# When SFU_PROVIDER=p2p
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_USERNAME=tiptalk
TURN_CREDENTIAL=tiptalkpass

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# --- Economy ---
PLATFORM_FEE_PCT=0.30
PAYOUT_MIN_TIPSYS=300

# --- Misc ---
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
MAX_MEDIA_BYTES=52428800

# Transactional email (Resend) — optional. The in-app inbox works without it;
# when set, message recipients get an email nudge to come read/reply.
# RESEND_API_KEY=
# EMAIL_FROM=TipTalk <hola@tiptalk.chat>

# --- App URLs ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
REALTIME_URL=http://localhost:4001
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# For local dev with docker-compose:
# DATABASE_URL=postgresql://tiptalk:tiptalk@localhost:5432/tiptalk?schema=public
# For SQLite (tests / quick start):
DATABASE_URL=file:./prisma/dev.db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-32-char-random-string-please
JWT_REFRESH_SECRET=replace-with-another-32-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- S3 / MinIO (media) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tiptalk-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/tiptalk-media

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_CLIENT_ID=ca_xxx

# --- Economy ---
PLATFORM_FEE_PCT=0.30
PAYOUT_MIN_TIPSYS=300

# --- WebRTC (coturn local + Google STUN) ---
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_USERNAME=tiptalk
TURN_CREDENTIAL=tiptalkpass

# --- Misc ---
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
MAX_MEDIA_BYTES=52428800
